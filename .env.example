# Copy to .env and fill in. Only JOSHY_PASSWORD and one notification channel are really needed.

# Password for the Joshy web dashboard (username is "joshy")
JOSHY_PASSWORD=change-me

# Where Joshy keeps its database and encryption key
JOSHY_DATA_DIR=./data

# Timezone used to decide when a date has passed
JOSHY_TIMEZONE=America/New_York

# Default seconds between availability checks for each watch
JOSHY_POLL_SECONDS=60

# --- Notifications (configure any or all) ---
# ntfy: install the ntfy app on your phone and subscribe to this topic.
# Pick a long random topic name, since anyone who knows it can read it.
JOSHY_NTFY_TOPIC=
JOSHY_NTFY_SERVER=https://ntfy.sh

# Pushover
JOSHY_PUSHOVER_TOKEN=
JOSHY_PUSHOVER_USER=

# Email over SMTP
JOSHY_SMTP_HOST=
JOSHY_SMTP_PORT=587
JOSHY_SMTP_USER=
JOSHY_SMTP_PASSWORD=
JOSHY_EMAIL_TO=
